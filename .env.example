# courier-outbox local configuration template.
# Copy to .env for Docker Compose. Never commit .env or real secrets.
# Values below are local-development placeholders only.

# --- API process -----------------------------------------------------------
HTTP_ADDR=:8080
LOG_LEVEL=info
API_PORT=8080

# --- Postgres (system of record) -------------------------------------------
POSTGRES_USER=courier
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=courier
POSTGRES_PORT=5432
# Used when running `courier` on the host instead of in Compose.
DATABASE_URL=postgres://courier:change-me-local-only@localhost:5432/courier?sslmode=disable

# --- Redis (leases / rate limits; not durable state) -----------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Secrets at rest --------------------------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Consumed once subscriptions land; leave empty until then.
COURIER_ENCRYPTION_KEY=

# --- Outbound webhook safety ------------------------------------------------
# Production defaults: SSRF_PROTECTION=true, ALLOW_HTTP_CALLBACKS=false.
# Compose relaxes them so the api can reach mock-subscriber over plain HTTP.
SSRF_PROTECTION=false
ALLOW_HTTP_CALLBACKS=true

# --- Mock subscriber (local demo target) -----------------------------------
MOCK_PORT=9090
MOCK_RESPONSE_STATUS=200
