# courier-outbox local configuration template.
# Copy to .env for Docker Compose. Never commit .env or real secrets.
# Values below are local-development placeholders only.

# --- API process -----------------------------------------------------------
HTTP_ADDR=:8080
LOG_LEVEL=info
API_PORT=8080

# --- Postgres (system of record) -------------------------------------------
POSTGRES_USER=courier
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=courier
POSTGRES_PORT=5432
# Used when running `courier` on the host instead of in Compose.
DATABASE_URL=postgres://courier:change-me-local-only@localhost:5432/courier?sslmode=disable

# --- Redis (leases / rate limits; not durable state) -----------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Secrets at rest --------------------------------------------------------
# Server-side pepper for API key hashes (HMAC-SHA256, ADR 0004). At least 32
# bytes. Changing it invalidates every existing API key.
# Generate with: openssl rand -base64 32
COURIER_API_KEY_PEPPER=local-dev-pepper-change-me-0123456789

# AES-256-GCM envelope key for subscription signing secrets (32 bytes, base64).
# Generate with: openssl rand -base64 32
# Required at process start. The value below is a local-development placeholder.
COURIER_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHktZW5jLWtleS0zMmJ5dGVzISE=

# --- Outbound webhook safety ------------------------------------------------
# Production defaults: SSRF_PROTECTION=true, ALLOW_HTTP_CALLBACKS=false.
# Compose relaxes them so the api can reach mock-subscriber over plain HTTP.
SSRF_PROTECTION=false
ALLOW_HTTP_CALLBACKS=true

# --- Worker (courier worker) ------------------------------------------------
# Lease owner id. Empty → hostname-pid at startup.
WORKER_ID=
# Claim/send goroutines and SKIP LOCKED batch size.
WORKER_CONCURRENCY=4
WORKER_CLAIM_LIMIT=8
# Exclusive claim duration and idle poll after an empty claim.
WORKER_LEASE_TTL=30s
WORKER_POLL_INTERVAL=500ms
# TEST ONLY. When set, every retry delay is this many milliseconds instead
# of 1s → 5s → 25s → 2m → 10m. Leave empty in every non-test environment.
# COURIER_BACKOFF_MS=10

# --- Mock subscriber (local demo target) -----------------------------------
MOCK_PORT=9090
MOCK_RESPONSE_STATUS=200
